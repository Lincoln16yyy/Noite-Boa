{
  "$schema": "https://oxlint.dev/schema.json",
  "rules": {
    "no-explicit-any": "error",
    "ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "no-underscore-dangle": ["error", { "allow": ["__fusoAparelho", "_resetarEstadoParaTestes"] }]
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "style": "warn",
    "perf": "warn",
    "nursery": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**/*.ts", "**/test/**/*.tsx", "**/setupTests.ts"],
      "rules": {
        "no-explicit-any": "off"
      }
    }
  ]
}
