{
  "$schema": "https://oxlint.dev/schema.json",
  "rules": {
    "no-explicit-any": "warn",
    "ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "no-underscore-dangle": ["error", { "allow": ["__fusoAparelho", "_resetarEstadoParaTestes"] }]
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "style": "warn",
    "perf": "warn",
    "nursery": "off"
  }
}