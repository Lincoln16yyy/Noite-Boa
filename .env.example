# ---- Banco de dados (desenvolvimento local) ----
POSTGRES_DB=sono
POSTGRES_USER=sono
POSTGRES_PASSWORD=sono_dev_only
DB_HOST=localhost
DB_PORT=5432

# ---- Back-end ----
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRATION_SECONDS=3600

# ---- Limite de tentativas de login/cadastro (429 com Retry-After) ----
RATELIMIT_LOGIN_LIMITE=5
RATELIMIT_LOGIN_JANELA=60
# Teto por e-mail, independente do IP (fecha o furo de forjar o IP; issue #155)
RATELIMIT_LOGIN_EMAIL_LIMITE=20
RATELIMIT_LOGIN_EMAIL_JANELA=3600
RATELIMIT_CADASTRO_LIMITE=5
RATELIMIT_CADASTRO_JANELA=3600
# IP real do cliente atrás do proxy da Render (base do limite acima)
FORWARD_HEADERS_STRATEGY=framework

# ---- Front-end ----
VITE_API_URL=http://localhost:8080/api

# ---- Produção (Render + Vercel): configure NA PLATAFORMA, nunca aqui ----
# Nada abaixo deve ser preenchido em arquivo .env versionado.
#
# Render (web service noiteboa-api):
#   SPRING_PROFILES_ACTIVE=prod            # já vem do render.yaml
#   SPRING_DATASOURCE_URL=jdbc:postgresql://<host-do-neon>/<banco>?sslmode=require
#   SPRING_DATASOURCE_USERNAME=<usuario-do-neon>
#   SPRING_DATASOURCE_PASSWORD=<senha-do-neon>
#   CORS_ALLOWED_ORIGINS=https://<app-do-front>.vercel.app,https://<app2>.vercel.app
#   # (o nome legado CORS_ALLOWED_ORIGIN também é aceito pelo back-end)
#   JWT_SECRET=$(openssl rand -base64 48)
#
# Vercel (variável de ambiente de build do front-end):
#   VITE_API_URL=https://<servico-da-api>.onrender.com/api
